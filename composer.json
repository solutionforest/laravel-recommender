{
    "name": "solutionforest/laravel-recommender",
    "description": "Simple recommendation engine for Laravel — self-hosted for-you feeds (collaborative filtering, trending, cached pages).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "php",
        "recommendation",
        "recommendation-engine",
        "recommender-system",
        "collaborative-filtering",
        "personalization",
        "feed",
        "trending",
        "content-discovery",
        "laravel-package"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/bus": "^11.0|^12.0|^13.0",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/pagination": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "laravel/prompts": "^0.1.25|^0.2|^0.3",
        "nesbot/carbon": "^2.72|^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "SolutionForest\\Recommender\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SolutionForest\\Recommender\\Tests\\": "tests/",
            "SolutionForest\\Recommender\\Examples\\Blog\\": "examples/blog/src/",
            "SolutionForest\\Recommender\\Examples\\Simple\\": "examples/simple/src/",
            "SolutionForest\\Recommender\\Examples\\Products\\": "examples/products/src/",
            "SolutionForest\\Recommender\\Examples\\Reviews\\": "examples/reviews/src/",
            "SolutionForest\\Recommender\\Examples\\Events\\": "examples/events/src/",
            "SolutionForest\\Recommender\\Examples\\EventsAdvanced\\": "examples/events-advanced/src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SolutionForest\\Recommender\\RecommenderServiceProvider"
            ],
            "aliases": {
                "Recommender": "SolutionForest\\Recommender\\Facades\\Recommender"
            }
        },
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "phpstan": "@analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://github.com/solutionforest/laravel-recommender",
    "support": {
        "issues": "https://github.com/solutionforest/laravel-recommender/issues",
        "source": "https://github.com/solutionforest/laravel-recommender",
        "docs": "https://github.com/solutionforest/laravel-recommender/tree/main/docs"
    },
    "authors": [
        {
            "name": "Solution Forest Limited",
            "homepage": "https://solutionforest.com"
        }
    ]
}
