<?php

namespace {{ namespace }};

use Carbon\CarbonImmutable;
use DateTimeInterface;
use Illuminate\Support\Collection;
use Illuminate\Support\Facades\DB;
use SolutionForest\Recommender\Contracts\InteractionSource;
use SolutionForest\Recommender\Support\Interaction;

/**
 * Reads interactions from your tables (any event names — not only like/view).
 * Adjust TABLES / column names to match your schema.
 */
class {{ class }} implements InteractionSource
{
    /** @var array<string, string> table => event name */
    private const TABLES = [
{{ tables_entries }}
    ];

    private const USER_RANGE = 500;

    private const ITEM_COLUMN = '{{ item_column }}';

    public function between(DateTimeInterface $from, DateTimeInterface $to): iterable
    {
        foreach (self::TABLES as $table => $event) {
            $rows = DB::table($table)
                ->where('created_at', '>', $from)
                ->where('created_at', '<=', $to)
                ->select(['id', 'user_id', self::ITEM_COLUMN, 'created_at']);

            foreach ($rows->lazyById(1000) as $row) {
                yield new Interaction(
                    (int) $row->user_id,
                    (int) $row->{self::ITEM_COLUMN},
                    $event,
                    CarbonImmutable::parse($row->created_at),
                );
            }
        }
    }

    public function userHistories(DateTimeInterface $since, int $perUser): iterable
    {
        $maxUserId = 0;
        foreach (array_keys(self::TABLES) as $table) {
            $maxUserId = max($maxUserId, (int) DB::table($table)->max('user_id'));
        }

        for ($start = 1; $start <= $maxUserId; $start += self::USER_RANGE) {
            $events = $this->events(
                fn ($q) => $q->whereBetween('user_id', [$start, $start + self::USER_RANGE - 1]),
                $since,
            );

            foreach ($events->groupBy('user_id') as $userId => $rows) {
                yield (int) $userId => array_values($rows->sortByDesc('created_at')
                    ->pluck(self::ITEM_COLUMN)
                    ->map(fn ($id) => (int) $id)
                    ->unique()
                    ->take($perUser)
                    ->all());
            }
        }
    }

    public function recentItems(int|string $userId, int $limit): array
    {
        return array_values($this->events(
            fn ($q) => $q->where('user_id', $userId)->orderByDesc('created_at')->limit($limit),
        )->sortByDesc('created_at')
            ->pluck(self::ITEM_COLUMN)
            ->map(fn ($id) => (int) $id)
            ->unique()
            ->take($limit)
            ->all());
    }

    /**
     * @param  callable(\Illuminate\Database\Query\Builder): \Illuminate\Database\Query\Builder  $scope
     * @return Collection<int, object>
     */
    private function events(callable $scope, ?DateTimeInterface $since = null): Collection
    {
        $all = collect();
        foreach (array_keys(self::TABLES) as $table) {
            $query = $scope(DB::table($table))->when($since, fn ($q) => $q->where('created_at', '>=', $since));
            $all = $all->concat($query->get(['user_id', self::ITEM_COLUMN, 'created_at']));
        }

        return $all;
    }
}
